---
interface Props {
  title: string;
  summary: string;
  stack?: string[];
  featured?: boolean;
  preview?: string;
  liveUrl?: string;
  repoUrl?: string;
  class?: string;
}

const {
  title,
  summary,
  stack = [],
  featured = false,
  preview,
  liveUrl,
  repoUrl,
  class: className = '',
} = Astro.props;
---

<article
  class:list={[
    'project-card',
    featured && 'project-card--featured',
    className,
  ].filter(Boolean)}
>
  <div class="project-preview">
    {preview && (
      <img
        src={preview}
        width="64"
        height="64"
        alt=""
        loading="lazy"
      />
    )}
    <div class="project-meta">
      {featured && (
        <span class="project-tag" aria-label="Featured project">
          Featured
        </span>
      )}
      {stack.length > 0 && (
        <span class="project-stack">
          {stack.map((s) => (
            <span class="pill">{s}</span>
          ))}
        </span>
      )}
    </div>
  </div>

  <div class="project-body">
    <h3>{title}</h3>
    <p>{summary}</p>
  </div>

  <ul class="project-actions">
    {liveUrl && (
      <li>
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="project-action project-action--demo"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
          Live demo
        </a>
      </li>
    )}
    {repoUrl && (
      <li>
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="project-action project-action--repo"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 0C5.373 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.73.083-.73 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.807 1.305 3.49.997.107-.775.415-1.305.757-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.312.469-2.388 1.236-3.223-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.835 1.235 1.911 1.235 3.223 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
          </svg>
          GitHub
        </a>
      </li>
    )}
  </ul>
</article>
