---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

const ordered = [projects.find((p) => p.id === 'writetrace'), projects.find((p) => p.id === 'moviemind'), projects.find((p) => p.id === 'resumeforge')];
---

<BaseLayout
  title="Work"
  description="Selected projects by Mohammed Ayaan Ahmed. Each project has a dedicated case study page."
  current="/projects"
>
  <div class="page-hero reveal">
    <p class="eyebrow">Work</p>
    <h1 class="display">Projects with context, not just screenshots.</h1>
    <p class="lede">
      Every project lives on its own page with goals, stack, role and results. No crowded list, no
      filler.
    </p>
  </div>

  <section class="section">
    <SectionHeading
      eyebrow="Project showcase"
      title="Three projects I have shipped"
      copy="Three projects exploring applied machine learning, intelligent systems, and software engineering. Each project includes a live demo and its source code."
    />
    <div class="project-showcase">
      {ordered[0] && (
        <ProjectCard
          title={ordered[0].data.title}
          summary={ordered[0].data.summary}
          stack={ordered[0].data.stack}
          liveUrl={ordered[0].data.liveUrl}
          repoUrl={ordered[0].data.repoUrl}
        />
      )}
      {ordered[1] && (
        <ProjectCard
          title={ordered[1].data.title}
          summary={ordered[1].data.summary}
          stack={ordered[1].data.stack}
          liveUrl={ordered[1].data.liveUrl}
          repoUrl={ordered[1].data.repoUrl}
        />
      )}
      {ordered[2] && (
        <ProjectCard
          title={ordered[2].data.title}
          summary={ordered[2].data.summary}
          stack={ordered[2].data.stack}
          liveUrl={ordered[2].data.liveUrl}
          repoUrl={ordered[2].data.repoUrl}
        />
      )}
    </div>
  </section>
</BaseLayout>
