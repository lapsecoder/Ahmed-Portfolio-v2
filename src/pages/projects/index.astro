---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

const [writetrace, moviemind, resumeforge] = projects;
---

<BaseLayout
  title="Work"
  description="Selected projects by Mohammed Ayaan Ahmed. Each project has a dedicated case study page."
  current="/projects"
>
  <div class="page-hero reveal">
    <p class="eyebrow">Work</p>
    <h1 class="display">Projects with context, not just screenshots.</h1>
    <p class="lede">
      Every project lives on its own page with goals, stack, role and results. No crowded list, no
      filler.
    </p>
  </div>

  <section class="section">
    <SectionHeading
      eyebrow="Project showcase"
      title="Three projects I have shipped"
      copy="Three projects exploring applied machine learning, intelligent systems, and software engineering. Each project includes a live demo and its source code."
    />
    <div class="project-showcase">
      {writetrace && (
        <ProjectCard
          title={writetrace.data.title}
          summary={writetrace.data.summary}
          stack={writetrace.data.stack}
          featured={writetrace.data.featured}
          preview={writetrace.data.preview}
          liveUrl={writetrace.data.liveUrl}
          repoUrl={writetrace.data.repoUrl}
        />
      )}
      {moviemind && (
        <ProjectCard
          title={moviemind.data.title}
          summary={moviemind.data.summary}
          stack={moviemind.data.stack}
          featured={moviemind.data.featured}
          preview={moviemind.data.preview}
          liveUrl={moviemind.data.liveUrl}
          repoUrl={moviemind.data.repoUrl}
        />
      )}
      {resumeforge && (
        <ProjectCard
          title={resumeforge.data.title}
          summary={resumeforge.data.summary}
          stack={resumeforge.data.stack}
          featured={resumeforge.data.featured}
          preview={resumeforge.data.preview}
          liveUrl={resumeforge.data.liveUrl}
          repoUrl={resumeforge.data.repoUrl}
        />
      )}
    </div>
  </section>
</BaseLayout>
